# Auto-loaded by Next.js for `next build` only (never `next dev`). No secret —
# NEXT_PUBLIC_* vars are baked into the public JS bundle, so this is committed
# (unlike the root `.env`/`apps/server/.env`, which hold real credentials).
#
# Points the desktop production build (`pnpm --filter @boardly/desktop
# tauri:build`) at the Dockerized backend (docker-compose.prod.yml, port 8788)
# instead of the dev-server default of 8787 (see lib/api-client.ts).
NEXT_PUBLIC_API_URL=http://localhost:8788

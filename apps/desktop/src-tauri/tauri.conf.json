{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boardly",
  "version": "1.0.0",
  "identifier": "vn.moonbase.boardly",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @boardly/web dev",
    "beforeBuildCommand": "pnpm --filter @boardly/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boardly",
        "width": 1280,
        "height": 832,
        "minWidth": 720,
        "minHeight": 480,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 ws://localhost:8787 http://localhost:8788 ws://localhost:8788 https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["boardly"]
      }
    }
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Boardly main window (Unit 5.2).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    },
    "notification:default",
    "deep-link:default",
    "opener:allow-open-url"
  ]
}

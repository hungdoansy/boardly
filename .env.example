# Copy to `.env` and adjust. `.env` is git-ignored.

# --- Postgres (docker-compose service `db`) ---
# Image tag; defaults to postgres:17. Override only if 17 is unavailable.
# POSTGRES_IMAGE=postgres:17
POSTGRES_USER=boardly
POSTGRES_PASSWORD=boardly
POSTGRES_DB=boardly
# Host port for the container's 5432 (5433 avoids a local Postgres on 5432).
POSTGRES_PORT=5433

# --- @boardly/server ---
# Must match the Postgres settings above.
DATABASE_URL=postgres://boardly:boardly@localhost:5433/boardly
PORT=8787
HOST=0.0.0.0

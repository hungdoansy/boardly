# Copy to `.env` and adjust. `.env` is git-ignored.

# --- Postgres (docker-compose service `db`) ---
# Image tag. Pin to the major that initialized your data volume — a newer major
# refuses an older data dir. postgres:16 matches the existing boardly_pgdata.
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=boardly
POSTGRES_PASSWORD=boardly
POSTGRES_DB=boardly
# Host port for the container's 5432 (5433 avoids a local Postgres on 5432).
POSTGRES_PORT=5433

# --- @boardly/server ---
# HOST-BASED DEV ONLY: `pnpm --filter @boardly/server dev` reads these to talk
# to the Postgres container. The Docker `server` service ignores them — it sets
# its own env in docker-compose.yml (DATABASE_URL points at host `db`:5432).
DATABASE_URL=postgres://boardly:boardly@localhost:5433/boardly
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# --- Docker production stack (service `server`) ---
# Host port the containerized server is published on. Deliberately 8788 (≠ the
# dev server's 8787) so both can run at once. The desktop app is built with
# NEXT_PUBLIC_API_URL=http://localhost:8788 to match.
# BOARDLY_SERVER_PORT=8788
# Comma-separated origins allowed to call the API with credentials. Includes the
# desktop webview origin (tauri://localhost). Uncomment to override the default.
# CORS_ORIGINS=http://localhost:3000,tauri://localhost,https://tauri.localhost

# --- Auth (Unit 3.3); all optional, defaults shown ---
# ACCESS_TOKEN_TTL_SECONDS=900      # 15 min
# REFRESH_TOKEN_TTL_DAYS=30
# LOGIN_RATE_MAX=5                  # login attempts per window (per IP)
# LOGIN_RATE_WINDOW_MS=60000
